<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | CivicConnect</title>
  <link rel="stylesheet" href="/styles/output.css" />
</head>
<body class="bg-slate-50 text-slate-800">
  <div class="flex min-h-screen">

    <!-- Brand panel -->
    <aside class="hidden w-1/2 flex-col justify-between bg-blue-700 p-12 lg:flex">
      <a href="/" class="text-lg font-semibold text-white">CivicConnect</a>

      <div class="max-w-md">
        <h2 class="text-3xl font-bold leading-tight text-white">
          One place for every service request.
        </h2>
        <p class="mt-3 text-slate-300">
          No more chasing email, WhatsApp and spreadsheets to find out what happened to a request.
        </p>

        <dl class="mt-10 space-y-5 text-sm">
          <div>
            <dt class="font-semibold text-white">Requesters</dt>
            <dd class="text-slate-400">Submit a request and follow its status.</dd>
          </div>
          <div>
            <dt class="font-semibold text-white">Staff</dt>
            <dd class="text-slate-400">Claim and resolve requests in your department.</dd>
          </div>
          <div>
            <dt class="font-semibold text-white">Management</dt>
            <dd class="text-slate-400">Track open, overdue and closed work.</dd>
          </div>
        </dl>
      </div>

      <p class="text-xs text-slate-500">SEN381 &middot; Team BugBusters</p>
    </aside>

    <!-- Form panel -->
    <main class="flex w-full flex-col items-center justify-center bg-slate-50 px-6 py-12 lg:w-1/2">
      <div class="w-full max-w-md">
        <a href="/" class="mb-8 block text-lg font-semibold text-slate-900 lg:hidden">CivicConnect</a>
        <h1 class="text-2xl font-bold text-slate-900"><%= authTitle %></h1>
        <p class="mt-1.5 text-sm text-slate-500"><%= authSubtitle %></p>
        <div class="mt-8">