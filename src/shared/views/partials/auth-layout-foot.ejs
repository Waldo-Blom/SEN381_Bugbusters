        </div>
      </div>
    </div>
  </div>
  <div data-page-loading class="hidden fixed inset-x-0 top-0 z-50 h-1 overflow-hidden bg-blue-100" aria-hidden="true">
    <div class="h-full w-1/3 animate-pulse bg-blue-600"></div>
  </div>
  <span data-page-loading-status class="sr-only" role="status" aria-live="polite"></span>
  <script src="/js/password-toggle.js"></script>
  <script src="/js/loading-state.js"></script>
</body>
