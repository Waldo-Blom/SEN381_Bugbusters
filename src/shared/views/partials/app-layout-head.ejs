<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | CivicConnect</title>
  <link rel="stylesheet" href="/styles/output.css" />
</head>
<body class="bg-slate-50 text-slate-800">
  <div class="flex h-screen overflow-hidden">

    <!-- Sidebar -->
    <aside class="hidden lg:flex w-72 flex-col border-r border-slate-200 bg-white">
      <div class="flex items-center gap-3 px-6 py-5 border-b border-slate-100">
        <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 text-white font-bold">C</div>
        <div>
          <p class="text-lg font-bold text-slate-900 leading-tight">CivicConnect</p>
          <p class="text-xs text-slate-500"><%= roleLabel %></p>
        </div>
      </div>

      <nav class="flex-1 space-y-1 px-3 py-4 overflow-y-auto">
        <% navItems.forEach(function (item) { %>
          <a href="<%= item.href %>"
             class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-all
                    <%= item.href === activeHref
                        ? 'bg-blue-50 text-blue-700'
                        : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900' %>">
            <%= item.label %>
          </a>
        <% }); %>
      </nav>

      <div class="border-t border-slate-100 p-3">
        <div class="flex items-center gap-3 rounded-lg px-3 py-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-100 text-blue-700 text-xs font-semibold">
            <%= user.avatarInitials %>
          </div>
          <div class="flex-1 min-w-0">
            <p class="truncate text-sm font-semibold text-slate-800"><%= user.name %></p>
            <p class="truncate text-xs text-slate-500"><%= user.email %></p>
          </div>
        </div>
        <a href="/auth/logout"
           class="mt-1 flex w-full items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-slate-600 hover:bg-red-50 hover:text-red-600 transition-colors">
          Sign out
        </a>
      </div>
    </aside>

    <!-- Main column -->
    <div class="flex flex-1 flex-col overflow-hidden">
      <header class="flex items-center gap-4 border-b border-slate-200 bg-white px-4 py-3.5 lg:px-8">
        <div class="lg:hidden flex h-9 w-9 items-center justify-center rounded-lg bg-blue-600 text-white font-bold">C</div>
        <div class="flex-1 min-w-0">
          <h1 class="text-lg font-bold text-slate-900 sm:text-xl"><%= pageTitle %></h1>
          <p class="hidden text-sm text-slate-500 sm:block"><%= pageSubtitle %></p>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto">
        <div class="mx-auto max-w-7xl px-4 py-6 lg:px-8">