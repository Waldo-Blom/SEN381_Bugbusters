<%- include('partials/app-layout-head', {
  title, user, navItems, activeHref, roleLabel, pageTitle, pageSubtitle
}) %>

<div class="space-y-5">
  <% if (error) { %>
    <p role="alert" class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"><%= error %></p>
  <% } %>
  <% if (success) { %>
    <p role="status" class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"><%= success %></p>
  <% } %>

  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="font-semibold text-slate-800">Add a request category</h2>
    <p class="mt-1 text-sm text-slate-500">Each category is assigned to one department and routes requests to that department.</p>

    <% if (departments.length === 0) { %>
      <p role="status" class="mt-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
        Create a department before adding request categories. <a href="/admin/departments/create" class="font-semibold underline">Add a department</a>.
      </p>
    <% } %>

    <form action="/admin/categories" method="POST" class="mt-5 grid gap-4 sm:grid-cols-2" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="space-y-1.5">
        <label for="name" class="block text-sm font-medium text-slate-700">Category name</label>
        <input id="name" name="name" type="text" value="<%= values.name || '' %>" required maxlength="100"
               aria-invalid="<%= errors.name ? 'true' : 'false' %>"
               class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
        <% if (errors.name) { %><p class="text-sm text-red-700"><%= errors.name %></p><% } %>
      </div>

      <div class="space-y-1.5">
        <label for="departmentId" class="block text-sm font-medium text-slate-700">Department</label>
        <select id="departmentId" name="departmentId" required aria-invalid="<%= errors.departmentId ? 'true' : 'false' %>"
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
          <option value="">Select one department</option>
          <% departments.forEach(function (department) { %>
            <option value="<%= department.departmentId %>" <%= values.departmentId === department.departmentId ? 'selected' : '' %>>
              <%= department.departmentName %>
            </option>
          <% }); %>
        </select>
        <% if (errors.departmentId) { %><p class="text-sm text-red-700"><%= errors.departmentId %></p><% } %>
      </div>

      <div class="space-y-1.5 sm:col-span-2">
        <label for="description" class="block text-sm font-medium text-slate-700">Description <span class="font-normal text-slate-500">(optional)</span></label>
        <textarea id="description" name="description" rows="3" maxlength="2000"
                  aria-invalid="<%= errors.description ? 'true' : 'false' %>"
                  class="w-full resize-y rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"><%= values.description || '' %></textarea>
        <% if (errors.description) { %><p class="text-sm text-red-700"><%= errors.description %></p><% } %>
      </div>

      <div class="sm:col-span-2 flex justify-end">
        <button type="submit" <%= departments.length === 0 ? 'disabled' : '' %>
                class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50">
          Add request category
        </button>
      </div>
    </form>
  </section>

  <section class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-4 py-3">
      <h2 class="font-semibold text-slate-800">Existing request categories</h2>
    </div>
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold">Category</th>
          <th scope="col" class="px-4 py-3 font-semibold">Department</th>
          <th scope="col" class="px-4 py-3 font-semibold">Status</th>
          <th scope="col" class="px-4 py-3 font-semibold">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (categories.length === 0) { %>
          <tr><td colspan="4" class="px-4 py-8 text-center text-slate-500">No request categories have been created.</td></tr>
        <% } else { %>
          <% categories.forEach(function (category) { %>
            <tr>
              <td class="px-4 py-3">
                <p class="font-medium text-slate-800"><%= category.categoryName %></p>
                <% if (category.description) { %><p class="mt-0.5 text-xs text-slate-500"><%= category.description %></p><% } %>
              </td>
              <td class="px-4 py-3 text-slate-600"><%= category.departmentName %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= category.isActive ? 'bg-green-50 text-green-700' : 'bg-slate-100 text-slate-600' %>">
                  <%= category.isActive ? 'Active' : 'Inactive' %>
                </span>
              </td>
              <td class="px-4 py-3">
                <% if (category.isActive) { %>
                  <form action="/admin/categories/<%= category.categoryId %>/deactivate" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-700 hover:bg-red-50">
                      Disable
                    </button>
                  </form>
                <% } else { %>
                  <form action="/admin/categories/<%= category.categoryId %>/activate" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="rounded-lg border border-green-200 px-3 py-1.5 text-xs font-semibold text-green-700 hover:bg-green-50">
                      Enable
                    </button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </section>
</div>

<%- include('partials/app-layout-foot') %>
