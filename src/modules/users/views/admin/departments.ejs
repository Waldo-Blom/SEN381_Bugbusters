<%- include('partials/app-layout-head', {
  title, user, navItems, activeHref, roleLabel, pageTitle, pageSubtitle
}) %>

<div class="space-y-5">
  <% if (success) { %>
    <p role="status" class="rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800"><%= success %></p>
  <% } %>

  <section class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="font-semibold text-slate-800">Departments</h2>
      <p class="mt-1 text-sm text-slate-500">Create departments independently, then assign a manager from the manager account form.</p>
    </div>
    <a href="/admin/departments/create" class="inline-flex justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
      Add department
    </a>
  </section>

  <section class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th scope="col" class="px-4 py-3 font-semibold">Department</th>
          <th scope="col" class="px-4 py-3 font-semibold">Manager</th>
          <th scope="col" class="px-4 py-3 font-semibold">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% if (departments.length === 0) { %>
          <tr><td colspan="3" class="px-4 py-8 text-center text-slate-500">No departments have been created.</td></tr>
        <% } else { %>
          <% departments.forEach(function (department) { %>
            <tr>
              <td class="px-4 py-3">
                <p class="font-medium text-slate-800"><%= department.departmentName %></p>
                <% if (department.description) { %><p class="mt-0.5 text-xs text-slate-500"><%= department.description %></p><% } %>
              </td>
              <td class="px-4 py-3 text-slate-600"><%= department.managerFirstName ? `${department.managerFirstName} ${department.managerLastName}` : 'Not assigned' %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-medium <%= department.isActive ? 'bg-green-50 text-green-700' : 'bg-slate-100 text-slate-600' %>">
                  <%= department.isActive ? 'Active' : 'Inactive' %>
                </span>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </section>
</div>

<%- include('partials/app-layout-foot') %>
