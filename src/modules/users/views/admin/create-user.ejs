<%- include('partials/app-layout-head', {
  title, user, navItems, activeHref, roleLabel, pageTitle, pageSubtitle
}) %>

<div class="mx-auto max-w-3xl space-y-5">
  <a href="/admin/users" class="inline-flex items-center text-sm font-medium text-blue-700 hover:text-blue-800">← Back to user management</a>

  <% if (departments.length === 0) { %>
    <p role="status" class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      There are no active departments available. An administrator must create or activate a department before registering a manager.
    </p>
  <% } %>

  <% if (departments.length === 0) { %>
    <p role="status" class="rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      No active departments are available yet. <a href="/admin/departments/create" class="font-semibold underline">Create a department</a> first, then return here to register its manager.
    </p>
  <% } %>

  <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <h2 class="font-semibold text-slate-800">Manager details</h2>
    <p class="mt-1 text-sm text-slate-500">Managers are assigned to one department. The selected department's current manager assignment will be replaced.</p>
    <form action="/admin/users" method="POST" class="mt-5 grid gap-4 sm:grid-cols-2" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="space-y-1.5">
        <label for="firstName" class="block text-sm font-medium text-slate-700">First name</label>
        <input id="firstName" name="firstName" type="text" value="<%= values.firstName || '' %>" required maxlength="100" autocomplete="given-name"
               aria-invalid="<%= errors.firstName ? 'true' : 'false' %>"
               class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
        <% if (errors.firstName) { %><p class="text-sm text-red-700"><%= errors.firstName %></p><% } %>
      </div>

      <div class="space-y-1.5">
        <label for="lastName" class="block text-sm font-medium text-slate-700">Last name</label>
        <input id="lastName" name="lastName" type="text" value="<%= values.lastName || '' %>" required maxlength="100" autocomplete="family-name"
               aria-invalid="<%= errors.lastName ? 'true' : 'false' %>"
               class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
        <% if (errors.lastName) { %><p class="text-sm text-red-700"><%= errors.lastName %></p><% } %>
      </div>

      <div class="space-y-1.5">
        <label for="email" class="block text-sm font-medium text-slate-700">Email</label>
        <input id="email" name="email" type="email" value="<%= values.email || '' %>" required maxlength="255" autocomplete="email"
               aria-invalid="<%= errors.email ? 'true' : 'false' %>"
               class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
        <% if (errors.email) { %><p class="text-sm text-red-700"><%= errors.email %></p><% } %>
      </div>

      <div class="space-y-1.5">
        <label for="phone" class="block text-sm font-medium text-slate-700">Phone <span class="font-normal text-slate-500">(optional)</span></label>
        <input id="phone" name="phone" type="tel" value="<%= values.phone || '' %>" maxlength="15" autocomplete="tel"
               aria-invalid="<%= errors.phone ? 'true' : 'false' %>"
               class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
        <% if (errors.phone) { %><p class="text-sm text-red-700"><%= errors.phone %></p><% } %>
      </div>

      <div class="space-y-1.5 sm:col-span-2">
        <label for="departmentId" class="block text-sm font-medium text-slate-700">Department</label>
        <select id="departmentId" name="departmentId" required aria-invalid="<%= errors.departmentId ? 'true' : 'false' %>"
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
          <option value="">Select a department</option>
          <% departments.forEach(function (department) { %>
            <option value="<%= department.departmentId %>" <%= values.departmentId === department.departmentId ? 'selected' : '' %>>
              <%= department.departmentName %><%= department.managerFirstName ? ` — current manager: ${department.managerFirstName} ${department.managerLastName}` : '' %>
            </option>
          <% }); %>
        </select>
        <% if (errors.departmentId) { %><p class="text-sm text-red-700"><%= errors.departmentId %></p><% } %>
      </div>

      <div class="space-y-1.5 sm:col-span-2">
        <label for="password" class="block text-sm font-medium text-slate-700">Initial password</label>
        <div class="relative">
          <input id="password" name="password" type="password" required autocomplete="new-password"
                 aria-invalid="<%= errors.password ? 'true' : 'false' %>"
                 class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 pr-16 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
          <button type="button" data-password-toggle aria-controls="password" aria-pressed="false" aria-label="Show password"
                  class="absolute inset-y-0 right-0 rounded-r-lg px-3 text-xs font-medium text-slate-500 hover:text-blue-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500">
            Show
          </button>
        </div>
        <% if (errors.password) { %><p class="text-sm text-red-700"><%= errors.password %></p><% } %>
        <p class="text-xs text-slate-500">At least 8 characters, including an uppercase letter and a number.</p>
      </div>

      <div class="sm:col-span-2 flex justify-end">
        <button type="submit" <%= departments.length === 0 ? 'disabled' : '' %>
                class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50">
          Create manager
        </button>
      </div>
    </form>
  </section>
</div>

<%- include('partials/app-layout-foot') %>
