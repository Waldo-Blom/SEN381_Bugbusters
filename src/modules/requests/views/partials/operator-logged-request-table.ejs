<div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
  <table class="w-full text-left text-sm">
    <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3 font-semibold">Reference</th>
        <th class="px-4 py-3 font-semibold">Requester</th>
        <th class="px-4 py-3 font-semibold">Request</th>
        <th class="px-4 py-3 font-semibold">Status</th>
        <th class="px-4 py-3 font-semibold">Submitted</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% if (requests.length === 0) { %>
        <tr>
          <td colspan="5" class="px-4 py-10 text-center text-sm text-slate-500">
            You have not logged any requests yet.
          </td>
        </tr>
      <% } else { %>
        <% requests.forEach(function (request) { %>
          <tr class="hover:bg-slate-50">
            <td class="whitespace-nowrap px-4 py-3 font-mono text-xs text-slate-500"><%= request.reference %></td>
            <td class="px-4 py-3 text-slate-700">
              <span class="block font-medium"><%= request.requesterName %></span>
              <% if (request.requesterEmail || request.requesterPhone) { %>
                <span class="mt-0.5 block text-xs text-slate-500"><%= request.requesterEmail || request.requesterPhone %></span>
              <% } %>
            </td>
            <td class="px-4 py-3">
              <a href="/operator/requests/<%= request.id %>" class="block font-medium text-slate-800 hover:text-blue-700"><%= request.title %></a>
              <% if (request.status === 'Submitted') { %>
                <a href="/operator/requests/<%= request.id %>/edit" class="mt-1 inline-block text-xs font-semibold text-blue-700 hover:text-blue-900">Edit request</a>
              <% } %>
              <span class="mt-0.5 block text-xs text-slate-500"><%= request.category %> · <%= request.location %></span>
            </td>
            <td class="whitespace-nowrap px-4 py-3">
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700"><%= request.status %></span>
            </td>
            <td class="whitespace-nowrap px-4 py-3 text-xs text-slate-500"><%= request.submittedAt %></td>
          </tr>
        <% }); %>
      <% } %>
    </tbody>
  </table>
</div>
