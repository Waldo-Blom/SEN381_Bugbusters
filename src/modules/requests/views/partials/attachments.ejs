<section class="rounded-xl border border-slate-200 bg-white shadow-sm" data-attachment-gallery data-request-id="<%= request.id %>">
  <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">Attached images</h3></div>
  <div class="px-5 py-4 space-y-3">
    <p data-attachment-status role="status" class="text-sm text-slate-500">Loading images...</p>
    <div data-attachment-images class="grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
    <% if (typeof attachmentCsrfToken === 'string') { %>
      <form method="POST" action="/requests/<%= request.id %>/attachments" enctype="multipart/form-data" data-attachment-upload class="space-y-3">
        <input type="hidden" name="_csrf" value="<%= attachmentCsrfToken %>" />
        <%- include('image-picker') %>
        <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50">Upload images</button>
      </form>
    <% } %>
    <noscript><a href="/requests/<%= request.id %>/attachments" class="text-sm text-blue-600">View image list</a></noscript>
  </div>
</section>
