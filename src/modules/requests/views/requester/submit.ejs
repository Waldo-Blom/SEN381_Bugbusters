<%- include('partials/app-layout-head', {
  title, user, navItems, activeHref, roleLabel, pageTitle, pageSubtitle
}) %>

<div class="mx-auto max-w-2xl space-y-6">

  <div class="flex items-start gap-3 rounded-xl border border-red-100 bg-red-50 px-4 py-3.5">
    <span class="mt-0.5 h-2 w-2 shrink-0 rounded-full bg-red-600"></span>
    <p class="text-sm text-red-800">
      Provide as much detail as possible so our team can address your request quickly. You'll receive updates as your request progresses.
    </p>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4">
      <h2 class="text-base font-bold text-slate-900">Service Request Form</h2>
      <p class="text-sm text-slate-500">All fields marked with * are required.</p>
    </div>

    <% if (Object.keys(errors).length > 0) { %>
      <div role="alert" class="mx-5 mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <p class="font-semibold"><%= typeof attachmentSaveFailed !== 'undefined' && attachmentSaveFailed ? 'We could not submit your request' : 'Please correct the following:' %></p>
        <ul class="mt-1 list-disc pl-5">
          <% Object.values(errors).forEach(function (message) { %>
            <li><%= message %></li>
          <% }); %>
        </ul>
        <% if (typeof attachmentSaveFailed !== 'undefined' && attachmentSaveFailed) { %>
          <p class="mt-2">Your request was not submitted. Your entered details are still here. Please select your images again before retrying.</p>
        <% } %>
      </div>
    <% } %>
    <% if (successReference) { %>
      <div role="status" class="mx-5 mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
        Request <strong><%= successReference %></strong> was logged successfully.
      </div>
    <% } %>

    <form id="serviceRequestForm" action="<%= formAction || '/requester/submit' %>" method="post" enctype="multipart/form-data" class="px-5 py-4 space-y-5">
      <input type="hidden" name="_csrf" value="<%= typeof uploadCsrfToken === 'string' ? uploadCsrfToken : '' %>" />

      <div class="space-y-1.5">
        <label for="categoryId" class="block text-sm font-medium text-slate-700">Category *</label>
        <select id="categoryId" name="categoryId" required
                class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20">
          <option value="">Select a category...</option>
          <% categories.forEach(function (category) { %>
            <option value="<%= category.id %>" <%= values.categoryId === category.id ? 'selected' : '' %>><%= category.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="space-y-1.5">
        <label for="title" class="block text-sm font-medium text-slate-700">Title *</label>
        <input id="title" name="title" type="text" maxlength="200" required value="<%= values.title || '' %>" placeholder="Brief summary of the issue"
               class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm placeholder-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
      </div>

      <div class="space-y-1.5">
        <label for="description" class="block text-sm font-medium text-slate-700">Description *</label>
        <textarea id="description" name="description" rows="5" required placeholder="Describe the issue in detail..."
                  class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm placeholder-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20"><%= values.description || '' %></textarea>
        <p class="text-xs text-slate-500">Tip: The more detail you provide, the faster we can resolve the issue.</p>
      </div>

      <div class="space-y-1.5">
        <label for="location" class="block text-sm font-medium text-slate-700">Location *</label>
        <input id="location" name="location" type="text" maxlength="255" required value="<%= values.location || '' %>" placeholder="e.g. 142 Maple Street, District 4"
               class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm placeholder-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
      </div>

      <% if (isOperator) { %>
        <%- include('../partials/external-requester-fields', { values }) %>
      <% } %>

      <div class="space-y-2">
        <label class="block text-sm font-medium text-slate-700">Priority (if applicable)</label>
        <input type="hidden" id="priority" name="priority" value="<%= values.priority || 'MEDIUM' %>" />
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          <% [
            { value: 'LOW', label: 'Low', description: 'Minor inconvenience' },
            { value: 'MEDIUM', label: 'Medium', description: 'Should be addressed soon' },
            { value: 'HIGH', label: 'High', description: 'Affects safety or traffic' },
            { value: 'URGENT', label: 'Urgent', description: 'Immediate hazard' },
          ].forEach(function (priority) { %>
            <% const selected = (values.priority || 'MEDIUM') === priority.value; %>
            <button
              type="button"
              data-priority="<%= priority.value %>"
              aria-pressed="<%= selected %>"
              class="<%= selected
                ? 'rounded-lg border-2 border-blue-500 bg-blue-50 px-3 py-2.5 text-center'
                : 'rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center hover:border-slate-300' %>"
            >
                <span class="block text-sm font-semibold text-slate-800"><%= priority.label %></span>
                <span class="mt-0.5 block text-[10px] leading-tight text-slate-500"><%= priority.description %></span>
            </button>
          <% }); %>
        </div>
      </div>

      <%- include('../partials/image-picker') %>
      <% if (Object.keys(errors).length > 0) { %>
        <p class="text-xs text-slate-500">If you selected images, please select them again before resubmitting.</p>
      <% } %>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end pt-2">
        <button id="submitRequestButton" type="submit" class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed">
          Submit request
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const serviceRequestForm = document.getElementById('serviceRequestForm');
  const submitRequestButton = document.getElementById('submitRequestButton');

  if (serviceRequestForm && submitRequestButton) {
    serviceRequestForm.addEventListener('submit', (e) => {
      if (e.defaultPrevented) return;
      if (serviceRequestForm.dataset.submitting === 'true') {
        e.preventDefault();
        return false;
      }
      serviceRequestForm.dataset.submitting = 'true';
      submitRequestButton.disabled = true;
      submitRequestButton.textContent = 'Submitting...';
      submitRequestButton.classList.add('opacity-50', 'cursor-not-allowed');
    });
  }

  const priorityInput = document.getElementById('priority');
  const priorityButtons = document.querySelectorAll('[data-priority]');

  priorityButtons.forEach((button) => {
    button.addEventListener('click', () => {
      priorityInput.value = button.dataset.priority;

      priorityButtons.forEach((option) => {
        const selected = option === button;
        option.setAttribute('aria-pressed', String(selected));
        option.className = selected
          ? 'rounded-lg border-2 border-blue-500 bg-blue-50 px-3 py-2.5 text-center'
          : 'rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-center hover:border-slate-300';
      });
    });
  });

  const memberSearch = document.getElementById('communityMemberSearch');
  if (memberSearch) {
    const results = document.getElementById('communityMemberResults');
    const searchStatus = document.getElementById('communityMemberSearchStatus');
    const memberId = document.getElementById('externalRequesterId');
    const fields = {
      firstName: document.getElementById('externalFirstName'),
      lastName: document.getElementById('externalLastName'),
      phone: document.getElementById('externalPhone'),
      email: document.getElementById('externalEmail'),
      preferredContactMethod: document.getElementById('preferredContactMethod'),
    };
    let debounceTimer;
    let activeSearch;

    const clearResults = () => {
      results.replaceChildren();
      results.classList.add('hidden');
    };

    const showMember = (member) => {
      memberId.value = member.id;
      fields.firstName.value = member.firstName || '';
      fields.lastName.value = member.lastName || '';
      fields.phone.value = member.phone || '';
      fields.email.value = member.email || '';
      fields.preferredContactMethod.value = member.preferredContactMethod || '';
      fields.firstName.required = false;
      fields.lastName.required = false;
      fields.preferredContactMethod.required = false;
      memberSearch.value = `${member.firstName} ${member.lastName}`.trim();
      searchStatus.textContent = 'Existing member selected. Their record will be reused.';
      clearResults();
    };

    const clearSelectedMember = () => {
      memberId.value = '';
      fields.firstName.required = true;
      fields.lastName.required = true;
      fields.preferredContactMethod.required = true;
    };

    if (memberId.value) {
      fields.firstName.required = false;
      fields.lastName.required = false;
      fields.preferredContactMethod.required = false;
      memberSearch.value = `${fields.firstName.value} ${fields.lastName.value}`.trim();
      searchStatus.textContent = 'Existing member selected. Their record will be reused.';
    }

    memberSearch.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      if (activeSearch) activeSearch.abort();
      clearSelectedMember();
      searchStatus.textContent = '';
      clearResults();

      const term = memberSearch.value.trim();
      if (term.length < 2) return;

      searchStatus.textContent = 'Searching...';
      debounceTimer = window.setTimeout(async () => {
        activeSearch = new AbortController();
        try {
          const response = await fetch(
            `/operator/community-members/search?q=${encodeURIComponent(term)}`,
            { signal: activeSearch.signal, headers: { Accept: 'application/json' } }
          );
          if (!response.ok) throw new Error('Unable to search community members.');

          const members = await response.json();
          clearResults();
          if (members.length === 0) {
            searchStatus.textContent = 'No matching members. Enter their details below.';
            return;
          }

          members.forEach((member) => {
            const option = document.createElement('button');
            const contact = member.email || member.phone || 'No contact details';
            option.type = 'button';
            option.role = 'option';
            option.className = 'block w-full border-b border-slate-100 px-3.5 py-2.5 text-left last:border-b-0 hover:bg-slate-50';
            option.textContent = `${member.firstName} ${member.lastName} — ${contact}`;
            option.addEventListener('click', () => showMember(member));
            results.append(option);
          });
          results.classList.remove('hidden');
          searchStatus.textContent = `${members.length} matching member${members.length === 1 ? '' : 's'}.`;
        } catch (error) {
          if (error.name !== 'AbortError') {
            searchStatus.textContent = error.message;
          }
        }
      }, 250);
    });

    Object.values(fields).forEach((field) => {
      field.addEventListener('input', () => {
        if (!memberId.value) return;
        clearSelectedMember();
        searchStatus.textContent = 'Member details changed. This will be saved as a new member.';
      });
      field.addEventListener('change', () => {
        if (!memberId.value) return;
        clearSelectedMember();
        searchStatus.textContent = 'Member details changed. This will be saved as a new member.';
      });
    });
  }
</script>

<script src="/js/request-images.js"></script>
<%- include('partials/app-layout-foot') %>
