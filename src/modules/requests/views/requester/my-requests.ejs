<%- include('partials/app-layout-head', {
  title, user, navItems, activeHref, roleLabel, pageTitle, pageSubtitle
}) %>

<% 
  const total = requests.length;
  const submitted = requests.filter(r => r.status === 'Submitted').length;
  const inProgress = requests.filter(r => r.status === 'In Progress').length;
  const resolved = requests.filter(r => r.status === 'Resolved').length;
  const closed = requests.filter(r => r.status === 'Closed').length;
  const summary = [
    { label: 'Total',       value: total,       cls: 'text-slate-900' },
    { label: 'Submitted',   value: submitted,   cls: 'text-slate-600' },
    { label: 'In Progress', value: inProgress,  cls: 'text-amber-600' },
    { label: 'Resolved',    value: resolved,    cls: 'text-emerald-600' },
    { label: 'Closed',      value: closed,      cls: 'text-gray-500' },
  ];
%>

<div class="space-y-5">

  <div class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-5">
    <% summary.forEach(function (s) { %>
      <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
        <p class="text-xs font-medium text-slate-500"><%= s.label %></p>
        <p class="mt-1 text-2xl font-bold <%= s.cls %>"><%= s.value %></p>
      </div>
    <% }); %>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <input type="text" placeholder="Search by title or reference..."
           class="w-full sm:max-w-md rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
    <a href="/requester/submit"
       class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
      + New Request
    </a>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% ['All','Submitted','Assigned','In Progress','Resolved','Closed'].forEach(function (f, i) { %>
      <button class="rounded-full px-3.5 py-1.5 text-sm font-medium transition-all
        <%= i === 0 ? 'bg-blue-600 text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50' %>">
        <%= f %>
      </button>
    <% }); %>
  </div>

  <div class="space-y-3">
    <% requests.forEach(function (r) { %>
      <a href="/requester/requests/<%= r.id %>"
         class="block rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-blue-300 transition-all">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs text-slate-400"><%= r.reference %></span>
              <% if (r.overdue) { %>
                <span class="rounded-md bg-red-50 px-1.5 py-0.5 text-xs font-medium text-red-600">Overdue</span>
              <% } %>
            </div>
            <h3 class="mt-1 truncate font-semibold text-slate-800"><%= r.title %></h3>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
              <span><%= r.location %></span>
              <span><%= r.submittedAt %></span>
            </div>
          </div>
          <div class="flex flex-col items-end gap-2 shrink-0">
            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
              <%= r.status %>
            </span>
            <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-600">
              <%= r.priority %>
            </span>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
</div>

<%- include('partials/app-layout-foot') %>