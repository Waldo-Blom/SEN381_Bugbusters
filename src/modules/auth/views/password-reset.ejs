<%- include('partials/auth-layout-head', {
  title: 'Reset Password',
  authTitle: 'Reset your password',
  authSubtitle: "Enter your email and we'll send you a reset link."
}) %>

<form action="/auth/login" method="POST" class="space-y-5">
  <div class="space-y-1.5">
    <label class="block text-sm font-medium text-slate-700">Email address</label>
    <input type="email" name="email" placeholder="you@email.com"
           class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm placeholder-slate-400 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
  </div>

  <button type="submit"
          class="w-full inline-flex items-center justify-center rounded-lg bg-blue-600 px-6 py-3 text-base font-semibold text-white hover:bg-blue-700 transition-colors">
    Send reset link
  </button>

  <a href="/auth/login"
     class="flex w-full items-center justify-center gap-2 text-sm font-medium text-slate-600 hover:text-slate-900">
    &larr; Back to sign in
  </a>
</form>

<%- include('partials/auth-layout-foot') %>