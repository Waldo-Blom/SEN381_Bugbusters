<%- include('../partials/header') %>

<!-- Hero -->
<section class="bg-blue-700 text-white">
  <div class="container mx-auto px-6 py-20 text-center">
    <h1 class="text-4xl md:text-5xl font-bold">Community service requests, finally under control.</h1>
    <p class="mt-4 max-w-2xl mx-auto text-blue-100">
      CivicConnect replaces scattered emails, phone calls, and spreadsheets with a single,
      traceable platform for submitting, tracking, and resolving community service requests.
    </p>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/auth/signup" class="px-6 py-3 rounded-lg bg-white text-blue-700 font-semibold hover:bg-blue-50">
        Submit a Request
      </a>
      <a href="/auth/login" class="px-6 py-3 rounded-lg border border-white text-white font-semibold hover:bg-blue-600">
        Staff Login
      </a>
    </div>
  </div>
</section>

<!-- What is CivicConnect? -->
<section class="py-16">
  <div class="container mx-auto px-6 max-w-3xl text-center">
    <h2 class="text-3xl font-bold text-slate-800">What is CivicConnect?</h2>
    <p class="mt-4 text-slate-600 leading-relaxed">
      CivicConnect is a community service request management platform built for local
      organisations. It gives requesters a clear way to report issues, gives staff a
      structured queue to action them, and gives management the visibility they need
      to keep service delivery accountable.
    </p>
  </div>
</section>

<!-- Who it serves -->
<section class="py-16 bg-white">
  <div class="container mx-auto px-6">
    <h2 class="text-3xl font-bold text-center text-slate-800">Built for three roles</h2>
    <div class="mt-12 grid gap-8 md:grid-cols-3">

      <div class="p-6 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="text-xl font-semibold text-blue-700">Requesters</h3>
        <p class="mt-2 text-slate-600 text-sm">
          Submit a service request, categorise it, and track its status from
          submission to resolution.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="text-xl font-semibold text-blue-700">Staff</h3>
        <p class="mt-2 text-slate-600 text-sm">
          View, filter, and claim requests. Update status, record actions, and
          close resolved work — all in one controlled queue.
        </p>
      </div>

      <div class="p-6 rounded-xl border border-slate-200 shadow-sm">
        <h3 class="text-xl font-semibold text-blue-700">Management</h3>
        <p class="mt-2 text-slate-600 text-sm">
          Track open, overdue, and resolved work. Analyse service activity by
          category and status for accountability.
        </p>
      </div>

    </div>
  </div>
</section>

<!-- Call to action -->
<section class="py-16 bg-slate-100">
  <div class="container mx-auto px-6 max-w-2xl text-center">
    <h2 class="text-2xl font-bold text-slate-800">Ready to get started?</h2>
    <p class="mt-3 text-slate-600">
      Create an account to submit your first service request.
    </p>
    <a href="/auth/signup" class="mt-6 inline-block px-6 py-3 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700">
      Create Account
    </a>
  </div>
</section>

<%- include('../partials/footer') %>