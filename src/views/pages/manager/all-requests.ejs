<%- include('../../partials/app-layout-head', {
  title, user, navItems, activeHref, roleLabel, pageTitle, pageSubtitle
}) %>

<div class="space-y-5">

  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="px-5 py-4 space-y-4">
      <input type="text" placeholder="Search requests..."
             class="w-full sm:max-w-md rounded-lg border border-slate-300 px-4 py-2.5 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500/20" />
      <div class="grid gap-3 sm:grid-cols-3">
        <div class="space-y-1.5"><label class="text-sm font-medium text-slate-700">Department</label>
          <select class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm"><option>All</option><option>Public Works</option><option>Utilities</option><option>Sanitation</option><option>Parks</option><option>Transportation</option><option>General Services</option></select></div>
        <div class="space-y-1.5"><label class="text-sm font-medium text-slate-700">Status</label>
          <select class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm"><option>All</option><option>Submitted</option><option>Assigned</option><option>In Progress</option><option>Resolved</option><option>Closed</option></select></div>
        <div class="space-y-1.5"><label class="text-sm font-medium text-slate-700">Category</label>
          <select class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm"><option>All</option><option>Pothole</option><option>Streetlight</option><option>Water Leak</option></select></div>
      </div>
    </div>
  </div>

  <p class="text-sm text-slate-600">Showing <span class="font-semibold text-slate-900"><%= requests.length %></span> of <%= requests.length %> requests</p>

  <div class="overflow-x-auto rounded-xl border border-slate-200 bg-white shadow-sm">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
        <tr>
          <th class="px-4 py-3 font-semibold">Reference</th>
          <th class="px-4 py-3 font-semibold">Title</th>
          <th class="px-4 py-3 font-semibold">Category</th>
          <th class="px-4 py-3 font-semibold">Dept</th>
          <th class="px-4 py-3 font-semibold">Status</th>
          <th class="px-4 py-3 font-semibold">Priority</th>
          <th class="px-4 py-3 font-semibold">Requester</th>
          <th class="px-4 py-3 font-semibold">Submitted</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% requests.forEach(function (r) { %>
          <tr onclick="window.location='/manager/requests/<%= r.id %>'" class="cursor-pointer hover:bg-blue-50/50 transition-colors">
            <td class="px-4 py-3 font-mono text-xs text-slate-500"><%= r.reference %></td>
            <td class="px-4 py-3 font-medium text-slate-800 max-w-[200px] truncate"><%= r.title %></td>
            <td class="px-4 py-3 text-slate-600"><%= r.category %></td>
            <td class="px-4 py-3 text-slate-600"><%= r.department %></td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700"><%= r.status %></span>
            </td>
            <td class="px-4 py-3">
              <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-600"><%= r.priority %></span>
            </td>
            <td class="px-4 py-3 text-slate-600"><%= r.requesterName %></td>
            <td class="px-4 py-3 text-xs text-slate-500"><%= r.submittedAt %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/app-layout-foot') %>