<%- include('../../partials/app-layout-head', {
  title, user, navItems, activeHref, roleLabel, pageTitle, pageSubtitle
}) %>

<%
  // Only show data for the logged-in manager's own department.
  const scoped = requests.filter(function (r) { return r.department === user.department; });

  const open     = scoped.filter(r => ['Submitted','Assigned','In Progress'].includes(r.status));
  const overdue  = scoped.filter(r => r.overdue);
  const resolved = scoped.filter(r => r.status === 'Resolved');
  const closed   = scoped.filter(r => r.status === 'Closed');

  // Recent activity scoped to this department
  const recent = scoped.slice(0, 5);
%>

<div class="space-y-5">

  <!-- Department banner -->
  <div class="flex items-center gap-2 rounded-lg bg-slate-50 border border-slate-200 px-3.5 py-2.5">
    <span class="text-xs font-semibold uppercase tracking-wide text-slate-500">Department</span>
    <span class="text-sm font-medium text-slate-800"><%= user.department %></span>
  </div>

  <!-- Metric cards -->
  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Open Requests</p>
      <p class="mt-1 text-2xl font-bold text-slate-900"><%= open.length %></p>
      <p class="mt-1 text-xs font-medium text-emerald-600">&uarr; +12%</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Overdue</p>
      <p class="mt-1 text-2xl font-bold text-slate-900"><%= overdue.length %></p>
      <p class="mt-1 text-xs font-medium text-red-600">&uarr; +3</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Resolved</p>
      <p class="mt-1 text-2xl font-bold text-slate-900"><%= resolved.length %></p>
      <p class="mt-1 text-xs font-medium text-emerald-600">&uarr; +18%</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-xs text-slate-500">Closed</p>
      <p class="mt-1 text-2xl font-bold text-slate-900"><%= closed.length %></p>
      <p class="mt-1 text-xs font-medium text-red-600">&darr; -5%</p>
    </div>
  </div>

  <!-- SLA metrics -->
  <div class="grid gap-5 lg:grid-cols-3">
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">Avg. Response Time</h3></div>
      <div class="px-5 py-4"><p class="text-3xl font-bold text-slate-900">4.2<span class="text-base font-normal text-slate-400"> hrs</span></p>
        <p class="mt-1 text-xs font-medium text-emerald-600">&darr; 15% faster than last week</p></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">Resolution Rate</h3></div>
      <div class="px-5 py-4"><p class="text-3xl font-bold text-slate-900">87<span class="text-base font-normal text-slate-400">%</span></p>
        <p class="mt-1 text-xs font-medium text-emerald-600">&uarr; +4% this month</p></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">SLA Compliance</h3></div>
      <div class="px-5 py-4"><p class="text-3xl font-bold text-slate-900">92<span class="text-base font-normal text-slate-400">%</span></p>
        <p class="mt-1 text-xs font-medium text-red-600">&darr; 2% below target</p></div>
    </div>
  </div>

  <!-- Recent activity -->
  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">Recent Activity</h3></div>
    <div class="divide-y divide-slate-100">
      <% if (recent.length === 0) { %>
        <div class="px-5 py-6 text-center text-sm text-slate-400">No recent activity.</div>
      <% } else { %>
        <% recent.forEach(function (r) { %>
          <a href="/manager/requests/<%= r.id %>" class="flex w-full items-center gap-4 px-5 py-3.5 text-left hover:bg-slate-50 transition-colors">
            <div class="flex-1 min-w-0">
              <p class="truncate text-sm font-medium text-slate-800"><%= r.title %></p>
              <p class="text-xs text-slate-400"><%= r.reference %> &middot; <%= r.category %> &middot; <%= r.updatedAt %></p>
            </div>
            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-700"><%= r.status %></span>
            <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-600"><%= r.priority %></span>
          </a>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<%- include('../../partials/app-layout-foot') %>