<div class="space-y-5">
  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">Request Info</h3></div>
    <div class="px-5 py-4 space-y-3.5 text-sm">
      <div><p class="text-xs text-slate-400">Category</p><p class="font-medium text-slate-700"><%= request.category %></p></div>
      <div><p class="text-xs text-slate-400">Department</p><p class="font-medium text-slate-700"><%= request.department %></p></div>
      <div><p class="text-xs text-slate-400">Location</p><p class="font-medium text-slate-700"><%= request.location %></p></div>
      <div><p class="text-xs text-slate-400">Submitted</p><p class="font-medium text-slate-700"><%= request.submittedAt %></p></div>
      <div><p class="text-xs text-slate-400">Last updated</p><p class="font-medium text-slate-700"><%= request.updatedAt %></p></div>
      <% if (request.assignedTo) { %>
        <div><p class="text-xs text-slate-400">Assigned to</p><p class="font-medium text-slate-700"><%= request.assignedTo %></p></div>
      <% } %>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">Requester Details</h3></div>
    <div class="px-5 py-4 space-y-3.5 text-sm">
      <div class="rounded-lg bg-amber-50 border border-amber-100 px-3 py-2">
        <span class="text-xs text-amber-700">Contact info is visible only because access has been authorised.</span>
      </div>
      <div><p class="text-xs text-slate-400">Name</p><p class="font-medium text-slate-700"><%= request.requesterName %></p></div>
      <div><p class="text-xs text-slate-400">Email</p><p class="font-medium text-slate-700"><%= request.requesterEmail %></p></div>
      <div><p class="text-xs text-slate-400">Phone</p><p class="font-medium text-slate-700"><%= request.requesterPhone %></p></div>
    </div>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">Assignment Controls</h3></div>
    <div class="px-5 py-4 space-y-3">
      <label class="block text-sm font-medium text-slate-700">Assign / reassign to</label>
      <select class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm">
        <option>Marcus Doyle — Public Works</option>
        <option>Sarah Lin — Utilities</option>
        <option>David Osei — Sanitation</option>
        <option>Elena Vasquez — Parks</option>
        <option>James Park — Transportation</option>
      </select>
      <label class="block text-sm font-medium text-slate-700">Set priority</label>
      <select class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm">
        <option <%= request.priority === 'Low'    ? 'selected' : '' %>>Low</option>
        <option <%= request.priority === 'Medium' ? 'selected' : '' %>>Medium</option>
        <option <%= request.priority === 'High'   ? 'selected' : '' %>>High</option>
        <option <%= request.priority === 'Urgent' ? 'selected' : '' %>>Urgent</option>
      </select>
      <button class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Reassign</button>
      <button class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Authorise contact access</button>
    </div>
  </div>
</div>