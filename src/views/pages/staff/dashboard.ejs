<%- include('../../partials/app-layout-head', {
  title, user, navItems, activeHref, roleLabel, pageTitle, pageSubtitle
}) %>

<%
  const available = requests.filter(r => r.status === 'Submitted' || r.status === 'Assigned');
  const assigned  = requests.filter(r => r.status === 'In Progress');
  const resolved  = requests.filter(r => r.status === 'Resolved');
  const overdue   = requests.filter(r => r.overdue);
%>

<div class="space-y-5">

  <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-5 text-white shadow-sm">
    <div>
      <p class="text-blue-100 text-sm">Welcome back, <%= user.name.split(' ')[0] %></p>
      <h2 class="text-lg font-bold"><%= user.department %> Department</h2>
    </div>
    <div class="flex gap-6 text-center">
      <div><p class="text-2xl font-bold"><%= available.length %></p><p class="text-xs text-blue-100">Available</p></div>
      <div><p class="text-2xl font-bold"><%= assigned.length %></p><p class="text-xs text-blue-100">In Progress</p></div>
      <div><p class="text-2xl font-bold"><%= overdue.length %></p><p class="text-xs text-blue-100">Overdue</p></div>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs text-slate-500">Available to accept</p><p class="text-xl font-bold text-slate-900"><%= available.length %></p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs text-slate-500">Assigned to me</p><p class="text-xl font-bold text-slate-900"><%= assigned.length %></p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs text-slate-500">Resolved this week</p><p class="text-xl font-bold text-slate-900"><%= resolved.length %></p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs text-slate-500">Overdue</p><p class="text-xl font-bold text-slate-900"><%= overdue.length %></p></div>
  </div>

  <!-- Filters -->
  <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-100 px-5 py-4"><h3 class="font-semibold text-slate-800">Filter Requests</h3></div>
    <div class="px-5 py-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-1.5"><label class="block text-sm font-medium text-slate-700">Status</label>
        <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm"><option>All</option><option>Submitted</option><option>Assigned</option><option>In Progress</option><option>Resolved</option><option>Closed</option></select></div>
      <div class="space-y-1.5"><label class="block text-sm font-medium text-slate-700">Category</label>
        <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm"><option>All</option><option>Pothole</option><option>Streetlight</option><option>Water Leak</option></select></div>
      <div class="space-y-1.5"><label class="block text-sm font-medium text-slate-700">Priority</label>
        <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm"><option>All</option><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select></div>
      <div class="space-y-1.5"><label class="block text-sm font-medium text-slate-700">Sort by</label>
        <select class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm"><option>Date</option><option>Priority</option><option>Status</option></select></div>
    </div>
  </div>

  <div class="space-y-3">
    <h3 class="text-base font-bold text-slate-900"><%= requests.length %> requests</h3>
    <% requests.forEach(function (r) { %>
      <a href="/staff/requests/<%= r.id %>"
         class="block rounded-xl border border-slate-200 bg-white p-4 shadow-sm hover:border-blue-300 transition-all">
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-mono text-xs text-slate-400"><%= r.reference %></span>
              <% if (r.overdue) { %><span class="rounded-md bg-red-50 px-1.5 py-0.5 text-xs font-medium text-red-600">Overdue</span><% } %>
            </div>
            <h3 class="mt-1 truncate font-semibold text-slate-800"><%= r.title %></h3>
            <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500">
              <span><%= r.location %></span><span><%= r.submittedAt %></span>
              <span class="font-medium text-slate-600">by <%= r.requesterName %></span>
            </div>
          </div>
          <div class="flex flex-col items-end gap-2 shrink-0">
            <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700"><%= r.status %></span>
            <span class="inline-flex items-center rounded-md border border-slate-200 bg-slate-50 px-2 py-0.5 text-xs font-medium text-slate-600"><%= r.priority %></span>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
</div>

<%- include('../../partials/app-layout-foot') %>