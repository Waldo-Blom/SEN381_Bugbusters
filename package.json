{
  "name": "sen381_bugbusters",
  "version": "1.0.0",
  "description": "CivicConnect is a digital platform designed to address operational challenges faced by a community-focused organization in managing citizen service requests. The organization currently manages requests through fragmented channels (email, telephone, WhatsApp, spreadsheets, paper-based protocols), resulting in duplicated, overlooked, or lost requests with no visibility into status or management oversight.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "watch:css": "npx @tailwindcss/cli -i ./src/public/styles/input.css -o ./src/public/styles/output.css --watch",
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
