
# ==========================================
# CIVICCONNECT - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=3000

# ==========================================
# DATABASE - NEON POSTGRESQL
# ==========================================

# Copy the pooled connection string from Neon:
# Project: CivicConnect
# Branch: development
# Database: civicconnect_dev

DATABASE_URL=postgresql://USERNAME:PASSWORD@YOUR_NEON_HOST-pooler.us-east-2.aws.neon.tech/civicconnect_dev?sslmode=require

# ==========================================
# SMTP - EMAIL CONFIGURATION
# ==========================================

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# ==========================================
# SESSION CONFIGURATION
# ==========================================

SESSION_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET
