
# ==========================================
# CIVICCONNECT - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=development
PORT=3000

# ==========================================
# DATABASE - NEON POSTGRESQL
# ==========================================

# Copy the pooled connection string from Neon:
# Project: CivicConnect
# Branch: development
# Database: civicconnect_dev

DATABASE_URL=postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_DEVELOPMENT_HOST/civicconnect_dev?sslmode=verify-full

# ==========================================
# NEON OBJECT STORAGE - DEVELOPMENT
# ==========================================

# AWS S3-compatible credentials from Neon
AWS_ACCESS_KEY_ID=your_neon_access_key_id
AWS_SECRET_ACCESS_KEY=your_neon_secret_access_key

# Neon Object Storage configuration
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=https://YOUR_DEVELOPMENT_BRANCH.storage.YOUR_REGION.aws.neon.tech

# Storage bucket
STORAGE_BUCKET=civicconnect-attachments

# ==========================================
# SMTP - EMAIL CONFIGURATION
# ==========================================

# Defaults: SMTP outside production; Gmail in production.
# Set EMAIL_PROVIDER=gmail to test Gmail without changing NODE_ENV.
# Set EMAIL_PROVIDER=smtp to force SMTP regardless of NODE_ENV.
# EMAIL_HOST/EMAIL_PORT apply when EMAIL_PROVIDER=smtp.
EMAIL_PROVIDER=
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# ==========================================
# SESSION CONFIGURATION
# ==========================================

SESSION_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET

# ==========================================
# TEMPORARY LOCAL DEMO LOGIN
# ==========================================
# Local development/testing only. Remove this demo-login feature and these
# settings before deploying to staging. Demo credentials must belong to active
# accounts already present in the database. Leave disabled by default.
ENABLE_DEMO_LOGINS=false
REQUESTER_EMAIL=
REQUESTER_PASSWORD=
STAFF_EMAIL=
STAFF_PASSWORD=
MANAGEMENT_EMAIL=
MANAGEMENT_PASSWORD=
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
